[
  {
    "id": "github-activity",
    "name": "GitHub activity of a user (every 15 min)",
    "active": false,
    "nodes": [
      {
        "id": "every-15-min",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "*/15 * * * *",
          "sample": {}
        }
      },
      {
        "id": "events",
        "type": "http",
        "x": 280,
        "y": 200,
        "params": {
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "MiniFlow",
            "Authorization": "{{ vars.githubToken == null ? null : 'Bearer ' + vars.githubToken }}"
          },
          "url": "https://api.github.com/users/{{ vars.githubUser }}/events/public?per_page=1"
        }
      },
      {
        "id": "has-event",
        "type": "if",
        "x": 520,
        "y": 200,
        "params": {
          "condition": "{{ input.ok and input.body.size() > 0 }}"
        }
      },
      {
        "id": "latest-event",
        "type": "set",
        "x": 760,
        "y": 140,
        "params": {
          "keepInput": false,
          "values": {
            "id": "{{ input.body[0].id }}",
            "type": "{{ input.body[0].type }}",
            "actor": "{{ input.body[0].actor.login }}",
            "repo": "{{ input.body[0].repo.name }}",
            "action": "{{ input.body[0].payload.action }}",
            "ref": "{{ input.body[0].payload.ref }}",
            "refType": "{{ input.body[0].payload.ref_type }}",
            "head": "{{ input.body[0].payload.head }}",
            "createdAt": "{{ input.body[0].created_at }}"
          }
        }
      },
      {
        "id": "is-new",
        "type": "dedupe",
        "x": 1000,
        "y": 140,
        "params": {
          "key": "{{ input.id }}"
        }
      },
      {
        "id": "message",
        "type": "set",
        "x": 1240,
        "y": 60,
        "params": {
          "values": {
            "text": "{{ input.type == 'PushEvent' ? '📦 ' + input.actor + ' pushed to ' + input.repo + '@' + input.ref.replace('refs/heads/', '') + ': https://github.com/' + input.repo + '/commit/' + input.head : (input.type == 'CreateEvent' ? '🆕 ' + input.actor + ' created ' + input.refType + (input.ref == null ? '' : ' ' + input.ref) + ' in ' + input.repo : (input.type == 'WatchEvent' ? '⭐ ' + input.actor + ' starred ' + input.repo : (input.type == 'ForkEvent' ? '🍴 ' + input.actor + ' forked ' + input.repo : '🔔 ' + input.actor + ' · ' + input.repo + ': ' + input.type + (input.action == null ? '' : ' (' + input.action + ')')))) }}"
          }
        }
      },
      {
        "id": "send",
        "type": "http",
        "x": 1480,
        "y": 60,
        "params": {
          "method": "POST",
          "url": "{{ vars.alertWebhook }}",
          "body": {
            "text": "{{ input.text }}"
          }
        }
      },
      {
        "id": "already-seen",
        "type": "log",
        "x": 1240,
        "y": 260,
        "params": {
          "message": "No new event (latest: {{ input.type }} {{ input.createdAt }})"
        }
      }
    ],
    "connections": [
      {
        "from": "every-15-min",
        "to": "events"
      },
      {
        "from": "events",
        "to": "has-event"
      },
      {
        "from": "has-event",
        "to": "latest-event",
        "branch": "true"
      },
      {
        "from": "latest-event",
        "to": "is-new"
      },
      {
        "from": "is-new",
        "to": "message",
        "branch": "new"
      },
      {
        "from": "is-new",
        "to": "already-seen",
        "branch": "seen"
      },
      {
        "from": "message",
        "to": "send"
      }
    ]
  },
  {
    "id": "github-stars",
    "name": "GitHub stars & forks tracker (daily 09:00)",
    "active": false,
    "nodes": [
      {
        "id": "daily-0900",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "0 9 * * *",
          "sample": {}
        }
      },
      {
        "id": "repo",
        "type": "http",
        "x": 280,
        "y": 200,
        "params": {
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "MiniFlow",
            "Authorization": "{{ vars.githubToken == null ? null : 'Bearer ' + vars.githubToken }}"
          },
          "url": "https://api.github.com/repos/{{ vars.githubRepo }}"
        }
      },
      {
        "id": "summary",
        "type": "set",
        "x": 520,
        "y": 200,
        "params": {
          "keepInput": false,
          "values": {
            "repo": "{{ input.body.full_name }}",
            "stars": "{{ input.body.stargazers_count }}",
            "forks": "{{ input.body.forks_count }}",
            "issues": "{{ input.body.open_issues_count }}",
            "url": "{{ input.body.html_url }}"
          }
        }
      },
      {
        "id": "changed",
        "type": "dedupe",
        "x": 760,
        "y": 200,
        "params": {
          "key": "{{ input.stars }}-{{ input.forks }}"
        }
      },
      {
        "id": "message",
        "type": "set",
        "x": 1000,
        "y": 120,
        "params": {
          "keepInput": false,
          "values": {
            "text": "⭐ {{ input.repo }}: {{ input.stars }} stars, {{ input.forks }} forks, {{ input.issues }} open issues\n{{ input.url }}"
          }
        }
      },
      {
        "id": "send",
        "type": "http",
        "x": 1240,
        "y": 120,
        "params": {
          "method": "POST",
          "url": "{{ vars.alertWebhook }}",
          "body": {
            "text": "{{ input.text }}"
          }
        }
      },
      {
        "id": "unchanged",
        "type": "log",
        "x": 1000,
        "y": 300,
        "params": {
          "message": "{{ input.repo }}: no change ({{ input.stars }}★)"
        }
      }
    ],
    "connections": [
      {
        "from": "daily-0900",
        "to": "repo"
      },
      {
        "from": "repo",
        "to": "summary"
      },
      {
        "from": "summary",
        "to": "changed"
      },
      {
        "from": "changed",
        "to": "message",
        "branch": "new"
      },
      {
        "from": "changed",
        "to": "unchanged",
        "branch": "seen"
      },
      {
        "from": "message",
        "to": "send"
      }
    ]
  },
  {
    "id": "github-weekly-summary",
    "name": "GitHub weekly repository summary (Monday 09:00)",
    "active": false,
    "nodes": [
      {
        "id": "monday-0900",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "0 9 * * MON",
          "sample": {}
        }
      },
      {
        "id": "repos",
        "type": "http",
        "x": 280,
        "y": 200,
        "params": {
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "MiniFlow",
            "Authorization": "{{ vars.githubToken == null ? null : 'Bearer ' + vars.githubToken }}"
          },
          "url": "https://api.github.com/users/{{ vars.githubUser }}/repos?sort=pushed&per_page=10"
        }
      },
      {
        "id": "summary",
        "type": "set",
        "x": 520,
        "y": 200,
        "params": {
          "keepInput": false,
          "values": {
            "text": "📊 {{ vars.githubUser }} weekly summary: {{ input.body.?[!fork].size() }} own repos, {{ input.body.?[fork].size() }} forks\nRecently updated: {{ input.body.![name + ' ★' + stargazers_count].toString().replace('[', '').replace(']', '') }}"
          }
        }
      },
      {
        "id": "send",
        "type": "http",
        "x": 760,
        "y": 200,
        "params": {
          "method": "POST",
          "url": "{{ vars.alertWebhook }}",
          "body": {
            "text": "{{ input.text }}"
          }
        }
      }
    ],
    "connections": [
      {
        "from": "monday-0900",
        "to": "repos"
      },
      {
        "from": "repos",
        "to": "summary"
      },
      {
        "from": "summary",
        "to": "send"
      }
    ]
  },
  {
    "id": "github-release-watch",
    "name": "New release watch (every 6 hours)",
    "active": false,
    "nodes": [
      {
        "id": "every-6-hours",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "0 */6 * * *",
          "sample": {}
        }
      },
      {
        "id": "latest-release",
        "type": "http",
        "x": 280,
        "y": 200,
        "params": {
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "MiniFlow",
            "Authorization": "{{ vars.githubToken == null ? null : 'Bearer ' + vars.githubToken }}"
          },
          "failOnError": false,
          "url": "https://api.github.com/repos/{{ vars.githubWatchRepo }}/releases/latest"
        }
      },
      {
        "id": "has-release",
        "type": "if",
        "x": 520,
        "y": 200,
        "params": {
          "condition": "{{ input.ok }}"
        }
      },
      {
        "id": "is-new",
        "type": "dedupe",
        "x": 760,
        "y": 140,
        "params": {
          "key": "{{ input.body.tag_name }}"
        }
      },
      {
        "id": "message",
        "type": "set",
        "x": 1000,
        "y": 60,
        "params": {
          "keepInput": false,
          "values": {
            "text": "🏷️ {{ vars.githubWatchRepo }} {{ input.body.tag_name }} released ({{ input.body.published_at }})\n{{ input.body.html_url }}"
          }
        }
      },
      {
        "id": "send",
        "type": "http",
        "x": 1240,
        "y": 60,
        "params": {
          "method": "POST",
          "url": "{{ vars.alertWebhook }}",
          "body": {
            "text": "{{ input.text }}"
          }
        }
      },
      {
        "id": "no-release",
        "type": "log",
        "x": 760,
        "y": 320,
        "params": {
          "message": "No release found for {{ vars.githubWatchRepo }} (HTTP {{ input.status }})"
        }
      }
    ],
    "connections": [
      {
        "from": "every-6-hours",
        "to": "latest-release"
      },
      {
        "from": "latest-release",
        "to": "has-release"
      },
      {
        "from": "has-release",
        "to": "is-new",
        "branch": "true"
      },
      {
        "from": "has-release",
        "to": "no-release",
        "branch": "false"
      },
      {
        "from": "is-new",
        "to": "message",
        "branch": "new"
      },
      {
        "from": "message",
        "to": "send"
      }
    ]
  },
  {
    "id": "sql-report-to-gist",
    "name": "Weekly SQL report → secret GitHub Gist (Monday 08:00)",
    "active": false,
    "nodes": [
      {
        "id": "monday-0800",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "0 8 * * MON",
          "sample": {}
        }
      },
      {
        "id": "weekly-stats",
        "type": "database",
        "x": 280,
        "y": 200,
        "params": {
          "credential": "miniflow-db",
          "maxRows": 500,
          "query": "SELECT workflow_name AS workflow, COUNT(*) AS runs, SUM(CASE WHEN status = 'SUCCESS' THEN 1 ELSE 0 END) AS succeeded, SUM(CASE WHEN status = 'ERROR' THEN 1 ELSE 0 END) AS failed, ROUND(AVG(duration_ms)) AS avg_ms FROM executions WHERE started_at >= CURRENT_DATE - INTERVAL '7' DAY GROUP BY workflow_name ORDER BY runs DESC"
        }
      },
      {
        "id": "has-rows",
        "type": "if",
        "x": 520,
        "y": 200,
        "params": {
          "condition": "{{ input.count > 0 }}"
        }
      },
      {
        "id": "create-gist",
        "type": "github",
        "x": 760,
        "y": 120,
        "params": {
          "credential": "github",
          "operation": "createGist",
          "fileName": "miniflow-weekly-{{ today }}.md",
          "description": "MiniFlow weekly execution report ({{ today }})",
          "content": "{{ input.rows }}",
          "public": false
        }
      },
      {
        "id": "result",
        "type": "set",
        "x": 1000,
        "y": 120,
        "params": {
          "keepInput": false,
          "values": {
            "ok": true,
            "gist": "{{ input.url }}",
            "workflows": "{{ nodes['weekly-stats'].count }}"
          }
        }
      },
      {
        "id": "nothing-to-report",
        "type": "log",
        "x": 760,
        "y": 300,
        "params": {
          "message": "No executions in the last 7 days, no gist created"
        }
      }
    ],
    "connections": [
      {
        "from": "monday-0800",
        "to": "weekly-stats"
      },
      {
        "from": "weekly-stats",
        "to": "has-rows"
      },
      {
        "from": "has-rows",
        "to": "create-gist",
        "branch": "true"
      },
      {
        "from": "has-rows",
        "to": "nothing-to-report",
        "branch": "false"
      },
      {
        "from": "create-gist",
        "to": "result"
      }
    ]
  },
  {
    "id": "dev-journal",
    "name": "Dev journal: today's commits + PRs → AI summary → database (weekdays 18:30)",
    "active": false,
    "nodes": [
      {
        "id": "weekdays-1830",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "30 18 * * MON-FRI",
          "sample": {}
        }
      },
      {
        "id": "commits",
        "type": "http",
        "x": 280,
        "y": 200,
        "params": {
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "MiniFlow"
          },
          "credential": "github-http",
          "url": "https://api.github.com/search/commits?q=author:{{ vars.githubUser }}+author-date:{{ today }}&sort=author-date&order=asc&per_page=100"
        }
      },
      {
        "id": "prs",
        "type": "http",
        "x": 520,
        "y": 200,
        "params": {
          "method": "GET",
          "headers": {
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "MiniFlow"
          },
          "credential": "github-http",
          "url": "https://api.github.com/search/issues?q=author:{{ vars.githubUser }}+type:pr+updated:{{ today }}&per_page=50"
        }
      },
      {
        "id": "collect",
        "type": "set",
        "x": 760,
        "y": 200,
        "params": {
          "keepInput": false,
          "values": {
            "commitCount": "{{ commits.body.total_count }}",
            "prCount": "{{ prs.body.total_count }}",
            "total": "{{ commits.body.total_count + prs.body.total_count }}",
            "commitLines": "{{ join(commits.body.items.!['- ' + repository.full_name + ': ' + commit.message.split('\\n')[0]], '\n') }}",
            "prLines": "{{ join(prs.body.items.!['- ' + repository_url.replace('https://api.github.com/repos/', '') + ': ' + title + ' (' + state + ')'], '\n') }}"
          }
        }
      },
      {
        "id": "any-activity",
        "type": "if",
        "x": 1000,
        "y": 200,
        "params": {
          "condition": "{{ input.total > 0 }}"
        }
      },
      {
        "id": "summarize",
        "type": "ai",
        "x": 1240,
        "y": 120,
        "params": {
          "credential": "gemini",
          "maxTokens": 400,
          "temperature": 0.3,
          "system": "You turn a developer's commits and pull requests into a stand-up note. Write exactly 3 short bullet points starting with \"• \": what was done, what is in progress, anything blocked or worth mentioning. Group related commits, skip trivial ones (typos, formatting). Plain text, no headings. Language: {{ default(vars.journalLanguage, 'English') }}.",
          "prompt": "Date: {{ today }}\n\nCommits ({{ input.commitCount }}):\n{{ input.commitLines }}\n\nPull requests ({{ input.prCount }}):\n{{ input.prLines }}"
        }
      },
      {
        "id": "save",
        "type": "database",
        "x": 1480,
        "y": 120,
        "params": {
          "credential": "miniflow-db",
          "query": "INSERT INTO dev_journal (day, summary, commits, pull_requests, created_at) VALUES (CAST(:day AS DATE), :summary, :commits, :prs, CURRENT_TIMESTAMP) ON CONFLICT (day) DO UPDATE SET summary = EXCLUDED.summary, commits = EXCLUDED.commits, pull_requests = EXCLUDED.pull_requests, created_at = EXCLUDED.created_at",
          "params": {
            "day": "{{ today }}",
            "summary": "{{ input.text }}",
            "commits": "{{ collect.commitCount }}",
            "prs": "{{ collect.prCount }}"
          }
        }
      },
      {
        "id": "quiet-day",
        "type": "log",
        "x": 1240,
        "y": 300,
        "params": {
          "message": "No commits or pull requests today, nothing saved"
        }
      }
    ],
    "connections": [
      {
        "from": "weekdays-1830",
        "to": "commits"
      },
      {
        "from": "commits",
        "to": "prs"
      },
      {
        "from": "prs",
        "to": "collect"
      },
      {
        "from": "collect",
        "to": "any-activity"
      },
      {
        "from": "any-activity",
        "to": "summarize",
        "branch": "true"
      },
      {
        "from": "any-activity",
        "to": "quiet-day",
        "branch": "false"
      },
      {
        "from": "summarize",
        "to": "save"
      }
    ]
  },
  {
    "id": "standup-note",
    "name": "Stand-up note: last journal entry → Slack (weekdays 09:45)",
    "active": false,
    "nodes": [
      {
        "id": "weekdays-0945",
        "type": "trigger",
        "x": 40,
        "y": 200,
        "params": {
          "cron": "45 9 * * MON-FRI",
          "sample": {}
        }
      },
      {
        "id": "last-entry",
        "type": "database",
        "x": 280,
        "y": 200,
        "params": {
          "credential": "miniflow-db",
          "maxRows": 1,
          "query": "SELECT day, summary, commits, pull_requests FROM dev_journal WHERE day < CAST(:today AS DATE) ORDER BY day DESC LIMIT 1",
          "params": {
            "today": "{{ today }}"
          }
        }
      },
      {
        "id": "has-entry",
        "type": "if",
        "x": 520,
        "y": 200,
        "params": {
          "condition": "{{ input.count > 0 }}"
        }
      },
      {
        "id": "post",
        "type": "slack",
        "x": 760,
        "y": 120,
        "params": {
          "credential": "slack",
          "text": "Stand-up: what I did on {{ input.first.day }}",
          "blocks": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "🧾 Stand-up · {{ input.first.day }}",
                "emoji": true
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "{{ input.first.summary }}"
              }
            },
            {
              "type": "context",
              "elements": [
                {
                  "type": "mrkdwn",
                  "text": "{{ input.first.commits }} commits · {{ input.first.pull_requests }} pull requests · from MiniFlow dev journal"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "no-entry",
        "type": "log",
        "x": 760,
        "y": 300,
        "params": {
          "message": "No journal entry yet"
        }
      }
    ],
    "connections": [
      {
        "from": "weekdays-0945",
        "to": "last-entry"
      },
      {
        "from": "last-entry",
        "to": "has-entry"
      },
      {
        "from": "has-entry",
        "to": "post",
        "branch": "true"
      },
      {
        "from": "has-entry",
        "to": "no-entry",
        "branch": "false"
      }
    ]
  },
  {
    "id": "github-push",
    "name": "GitHub webhook events: push, PR, issue, star",
    "active": true,
    "nodes": [
      {
        "id": "github",
        "type": "trigger",
        "x": 40,
        "y": 320,
        "params": {
          "path": "github",
          "signatureSecretVar": "githubWebhookSecret",
          "sample": {
            "_headers": {
              "x-github-event": "push"
            },
            "ref": "refs/heads/main",
            "repository": {
              "full_name": "omernaci/medium-samples",
              "stargazers_count": 3
            },
            "pusher": {
              "name": "omernaci"
            },
            "sender": {
              "login": "omernaci"
            },
            "commits": [
              {
                "message": "Update sample code"
              },
              {
                "message": "Fix README"
              }
            ],
            "head_commit": {
              "message": "Fix README"
            },
            "compare": "https://github.com/omernaci/medium-samples/compare/abc...def"
          }
        }
      },
      {
        "id": "event",
        "type": "set",
        "x": 260,
        "y": 320,
        "params": {
          "values": {
            "event": "{{ input._headers == null ? null : input._headers['x-github-event'] }}"
          }
        }
      },
      {
        "id": "is-ping",
        "type": "if",
        "x": 500,
        "y": 40,
        "params": {
          "condition": "{{ input.event == 'ping' }}"
        }
      },
      {
        "id": "pong",
        "type": "set",
        "x": 760,
        "y": 0,
        "params": {
          "keepInput": false,
          "values": {
            "ok": true,
            "message": "pong: webhook connection works",
            "hookId": "{{ input.hook_id }}"
          }
        }
      },
      {
        "id": "is-push",
        "type": "if",
        "x": 500,
        "y": 180,
        "params": {
          "condition": "{{ input.event == 'push' and input.commits != null and input.commits.size() > 0 }}"
        }
      },
      {
        "id": "push-message",
        "type": "set",
        "x": 760,
        "y": 140,
        "params": {
          "keepInput": false,
          "values": {
            "text": "🚀 {{ input.pusher.name }} pushed {{ input.commits.size() }} commit(s) to {{ input.repository.full_name }}@{{ input.ref.replace('refs/heads/', '') }}: \"{{ input.head_commit.message }}\"\n{{ input.compare }}"
          }
        }
      },
      {
        "id": "is-pr",
        "type": "if",
        "x": 500,
        "y": 320,
        "params": {
          "condition": "{{ input.event == 'pull_request' }}"
        }
      },
      {
        "id": "pr-message",
        "type": "set",
        "x": 760,
        "y": 280,
        "params": {
          "keepInput": false,
          "values": {
            "text": "🔀 PR #{{ input.number }} {{ input.action }}: {{ input.pull_request.title }} ({{ input.sender.login }})\n{{ input.pull_request.html_url }}"
          }
        }
      },
      {
        "id": "is-issue",
        "type": "if",
        "x": 500,
        "y": 460,
        "params": {
          "condition": "{{ input.event == 'issues' }}"
        }
      },
      {
        "id": "issue-message",
        "type": "set",
        "x": 760,
        "y": 420,
        "params": {
          "keepInput": false,
          "values": {
            "text": "🐞 Issue #{{ input.issue.number }} {{ input.action }}: {{ input.issue.title }} ({{ input.sender.login }})\n{{ input.issue.html_url }}"
          }
        }
      },
      {
        "id": "is-star",
        "type": "if",
        "x": 500,
        "y": 600,
        "params": {
          "condition": "{{ input.event == 'star' }}"
        }
      },
      {
        "id": "star-message",
        "type": "set",
        "x": 760,
        "y": 560,
        "params": {
          "keepInput": false,
          "values": {
            "text": "{{ input.action == 'created' ? '⭐ ' + input.sender.login + ' starred ' + input.repository.full_name + ' (total ' + input.repository.stargazers_count + ')' : '💔 ' + input.sender.login + ' unstarred ' + input.repository.full_name }}"
          }
        }
      },
      {
        "id": "other",
        "type": "set",
        "x": 760,
        "y": 720,
        "params": {
          "keepInput": false,
          "values": {
            "ok": true,
            "ignored": "'{{ input.event }}' event not handled"
          }
        }
      },
      {
        "id": "send",
        "type": "http",
        "x": 1040,
        "y": 320,
        "params": {
          "method": "POST",
          "url": "{{ vars.alertWebhook }}",
          "body": {
            "text": "{{ input.text }}"
          }
        }
      },
      {
        "id": "done",
        "type": "set",
        "x": 1300,
        "y": 320,
        "params": {
          "keepInput": false,
          "values": {
            "ok": true,
            "event": "{{ nodes['event'].event }}"
          }
        }
      }
    ],
    "connections": [
      {
        "from": "github",
        "to": "event"
      },
      {
        "from": "event",
        "to": "is-ping"
      },
      {
        "from": "is-ping",
        "to": "pong",
        "branch": "true"
      },
      {
        "from": "is-ping",
        "to": "is-push",
        "branch": "false"
      },
      {
        "from": "is-push",
        "to": "push-message",
        "branch": "true"
      },
      {
        "from": "is-push",
        "to": "is-pr",
        "branch": "false"
      },
      {
        "from": "is-pr",
        "to": "pr-message",
        "branch": "true"
      },
      {
        "from": "is-pr",
        "to": "is-issue",
        "branch": "false"
      },
      {
        "from": "is-issue",
        "to": "issue-message",
        "branch": "true"
      },
      {
        "from": "is-issue",
        "to": "is-star",
        "branch": "false"
      },
      {
        "from": "is-star",
        "to": "star-message",
        "branch": "true"
      },
      {
        "from": "is-star",
        "to": "other",
        "branch": "false"
      },
      {
        "from": "push-message",
        "to": "send"
      },
      {
        "from": "pr-message",
        "to": "send"
      },
      {
        "from": "issue-message",
        "to": "send"
      },
      {
        "from": "star-message",
        "to": "send"
      },
      {
        "from": "send",
        "to": "done"
      }
    ]
  }
]
