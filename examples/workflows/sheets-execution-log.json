{
  "id": "sheets-execution-log",
  "name": "Google Sheets: yesterday's MiniFlow executions → sheet (daily 06:00)",
  "active": false,
  "nodes": [
    {
      "id": "daily-0600",
      "type": "trigger",
      "x": 40,
      "y": 200,
      "params": {
        "cron": "0 6 * * *",
        "sample": {}
      }
    },
    {
      "id": "yesterday",
      "type": "database",
      "x": 280,
      "y": 200,
      "params": {
        "credential": "miniflow-db",
        "maxRows": 5000,
        "query": "SELECT started_at, workflow_name AS workflow, run_mode AS mode, status, duration_ms FROM executions WHERE started_at >= CURRENT_DATE - INTERVAL '1' DAY AND started_at < CURRENT_DATE ORDER BY started_at"
      }
    },
    {
      "id": "has-rows",
      "type": "if",
      "x": 520,
      "y": 200,
      "params": {
        "condition": "{{ input.count > 0 }}"
      }
    },
    {
      "id": "append-rows",
      "type": "googleSheets",
      "x": 760,
      "y": 120,
      "params": {
        "credential": "google",
        "operation": "append",
        "spreadsheetId": "{{ vars.sheetId }}",
        "range": "Executions",
        "values": "{{ input.rows }}",
        "columns": [
          "started_at",
          "workflow",
          "mode",
          "status",
          "duration_ms"
        ]
      }
    },
    {
      "id": "done",
      "type": "log",
      "x": 1000,
      "y": 120,
      "params": {
        "message": "{{ input.appendedRows }} execution(s) written to {{ input.updatedRange }}"
      }
    }
  ],
  "connections": [
    {
      "from": "daily-0600",
      "to": "yesterday"
    },
    {
      "from": "yesterday",
      "to": "has-rows"
    },
    {
      "from": "has-rows",
      "to": "append-rows",
      "branch": "true"
    },
    {
      "from": "append-rows",
      "to": "done"
    }
  ]
}
